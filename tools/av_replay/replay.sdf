<?xml version="1.0"?>
<sdf version="1.8">
  <world name="replay">
    <scene><shadows>1</shadows><ambient>0.7 0.7 0.7 1</ambient><background>0.93 0.94 0.96 1</background></scene>
    <physics type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.22 0.16 -1</direction></light>
    <model name="ground"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual></link></model>
    <include><uri>model://turtlebot3_house</uri></include>
    <include><name>burger</name><static>true</static><pose>-2.0 -0.5 0.01 0 0 0</pose><uri>model://turtlebot3_burger</uri></include>
    <model name="marker"><static>true</static><pose>-2.0 -0.5 0.004 0 0 0</pose><link name="l">
      <visual name="v"><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.26</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.1 0.45 1 1</ambient><diffuse>0.1 0.45 1 1</diffuse><emissive>0.1 0.4 0.9 1</emissive></material><transparency>0.45</transparency></visual></link></model>
    <model name="cam"><static>true</static><pose>-5.5 -4.0 4.0 0 0.62 0.75</pose><link name="l">
      <sensor name="c" type="camera"><always_on>1</always_on><update_rate>10</update_rate>
        <camera><horizontal_fov>0.75</horizontal_fov><image><width>960</width><height>540</height></image>
          <clip><near>0.1</near><far>100</far></clip>
          </camera></sensor></link></model>
  </world>
</sdf>
